@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime

<div class="page @(isDarkMode ? "dark-theme" : "light-theme")">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Pathfinder 2E Spell Database</h3>
            <div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleTheme">
                    <i class="@(isDarkMode ? "fas fa-sun" : "fas fa-moon")"></i>
                    @(isDarkMode ? "Light" : "Dark") Mode
                </button>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool isDarkMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var darkModeValue = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "darkMode");
            isDarkMode = darkModeValue == "true";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "darkMode", isDarkMode.ToString().ToLower());
        StateHasChanged();
    }
}
